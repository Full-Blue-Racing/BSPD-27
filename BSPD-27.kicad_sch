	(text "The soldermask legend shows \nthe relay NC and NO positions.\n\nFor a fail-safe BSPD, the SC \nis open unless sc_in is high\nand the relay is energised. \n\nSo basically RNC_SC_out can be\nleft floating, and RNO_SC_out \nis the real SC_out"
		(exclude_from_sim no)
		(at 364.49 62.23 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "1a0237a9-6a6b-428f-860e-3d46faada5aa")
	)
	(text "R_on goes low after \nfault clears\n"
		(exclude_from_sim no)
		(at 230.124 222.758 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "349084d6-ea9b-4e22-a0b5-3a1db353fe4c")
	)
	(text "ALSO USE TRIMMER HERE???\nALSO IS THERE A NEED FOR INVERTER?\n"
		(exclude_from_sim no)
		(at 86.868 203.708 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "3a2ac46c-4ce0-416d-a705-128cdd54aab6")
	)
	(text "t = RC\n10ms = 0.1*10e-6 * 10e5\nPower-on reset, C14 charges, \ngives a 10ms on-pulse at Q2.\nC13 discharges to GND"
		(exclude_from_sim no)
		(at 146.558 278.892 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "70bd8e81-48a6-46f3-9847-c029a9d791e9")
	)
	(text "t = RC\n10s = 10*10e-6 * 1M\nThreshold tuned via POT\n"
